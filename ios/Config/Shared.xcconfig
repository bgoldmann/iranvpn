// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = IranVPN
PRODUCT_DISPLAY_NAME = Iran VPN
PRODUCT_BUNDLE_IDENTIFIER = com.goldmannllc.IranVPN
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 18.4

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2 

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown
// VPN uses cryptography beyond HTTPS-only exemptions — declare in App Store Connect.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon


// ==========================================
// Entitlements
// ==========================================
#include "NetworkExtension.xcconfig"
// Device: empty by default; set IRANVPN_ENTITLEMENTS_SUFFIX = -NetworkExtension after portal.
// Simulator never gets Packet Tunnel entitlements.
CODE_SIGN_ENTITLEMENTS = Config/IranVPN$(IRANVPN_ENTITLEMENTS_SUFFIX).entitlements
CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*] = Config/IranVPN-Simulator.entitlements
